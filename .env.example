# Copia este archivo a ".env" (en la raíz del proyecto) y ajusta los valores
# antes de levantar el proyecto con `docker-compose up`.

POSTGRES_USER=fitness_user
POSTGRES_PASSWORD=fitness_pass
POSTGRES_DB=fitness_coach

SECRET_KEY=change-me-in-production
ENVIRONMENT=development

# --- Fase 4: coach LLM (Anthropic Claude) ---
# Déjala vacía para trabajar en modo "dry-run" (el backend arma el prompt pero no
# llama al modelo). Ponla para recibir recomendaciones generadas por Claude.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5

# --- Despliegue (Railway u otro PaaS) — ver DEPLOY.md ---
# En producción, pon ENVIRONMENT=production. La plataforma inyecta PORT y DATABASE_URL
# (la app convierte "postgresql://" al driver asyncpg automáticamente).
# AUTO_CREATE_TABLES=true  # crea tablas al arrancar; ponlo en false si usas Alembic
# CORS_ORIGINS=["*"]       # restríngelo a tu dominio cuando publiques el frontend
