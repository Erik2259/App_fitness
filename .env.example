# Copia este archivo a ".env" (en la raíz del proyecto) y ajusta los valores
# antes de levantar el proyecto con `docker-compose up`.

POSTGRES_USER=fitness_user
POSTGRES_PASSWORD=fitness_pass
POSTGRES_DB=fitness_coach

SECRET_KEY=change-me-in-production
ENVIRONMENT=development

# --- Fase 4: coach LLM (Anthropic Claude) ---
# Déjala vacía para trabajar en modo "dry-run" (el backend arma el prompt pero no
# llama al modelo). Ponla para recibir recomendaciones generadas por Claude.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5
